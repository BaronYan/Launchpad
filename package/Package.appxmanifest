<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX 包清单（Desktop Bridge / 完全信任的 Win32 应用）。

  提交到 Microsoft Store 前必须把下面三个占位符换成你 Partner Center 里的真实值：
    Identity Name      —— Partner Center → 产品 → 产品标识 → 包/Identity 名称（形如 12345Publisher.Launchpad）
    Identity Publisher —— 同一页的“发布者 ID”（形如 CN=1A2B3C4D-...）
    PublisherDisplayName —— 你的开发者显示名称

  build-msix.ps1 会读取 -Identity / -Publisher / -PublisherName 参数替换这些值，
  生成最终的 AppxManifest.xml 再打包。
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <Identity
    Name="__IDENTITY__"
    Publisher="__PUBLISHER__"
    Version="__VERSION__"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>__DISPLAY_NAME__</DisplayName>
    <PublisherDisplayName>__PUBLISHER_NAME__</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>macOS Launchpad 风格的 Windows 应用启动器</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="zh-CN" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="Launchpad.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="__DISPLAY_NAME__"
        Description="macOS Launchpad 风格的应用启动器"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square71x71Logo="Assets\Square71x71Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png" />
      </uap:VisualElements>

      <Extensions>
        <!-- 开机启动：由系统托管，用户在“设置 → 应用 → 启动”里可以开关 -->
        <desktop:Extension Category="windows.startupTask" Executable="Launchpad.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="LaunchpadStartup" Enabled="false" DisplayName="__DISPLAY_NAME__" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>

